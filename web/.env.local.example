# Server-side only — never prefix these with NEXT_PUBLIC_.
FASTAPI_BASE_URL=http://localhost:8000

# Must match api/.env's API_SERVICE_KEY value.
API_SERVICE_KEY=

# NL stats search BFF route (app/api/search) — server-side only.
# SEARCH_LLM_PROVIDER selects the provider: "anthropic" | "gemini" | "groq",
# defaults to "groq" (free tier, LPU hardware) when unset.
# SEARCH_LLM_PROVIDER=groq
GROQ_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Gates the homepage/Trust Center "we tell you when data disagrees" pitch
# copy (web/lib/feature-flags.ts). Defaults to false (safe copy) when
# unset -- flip to "true" only after the real-data verification checklist
# in docs/PROGRESS.md's "Bettor-trust pivot Phase A follow-up" clears.
# TRUST_CENTER_LIVE=true
