# Postgres (docker-compose + all services)
POSTGRES_USER=nba
POSTGRES_PASSWORD=nba
POSTGRES_DB=nba
DATABASE_URL=postgresql+psycopg://nba:nba@localhost:5432/nba

# Least-privilege runtime credentials (created by the db-foundations role migrations;
# DATABASE_URL above stays the admin/migration connection).
INGESTION_DATABASE_URL=postgresql+psycopg://ingestion_writer:ingestion_writer_pw@localhost:5432/nba
API_DATABASE_URL=postgresql+psycopg://api_reader:api_reader_pw@localhost:5432/nba

# Redis (caching, week 4+)
REDIS_URL=redis://localhost:6379/0

# Ingestion sources
BALLDONTLIE_API_KEY=

# Shared secret the Next.js BFF sends to FastAPI as X-API-Key.
# Never exposed to the browser — lives only in api/.env and web/.env.local.
API_SERVICE_KEY=
