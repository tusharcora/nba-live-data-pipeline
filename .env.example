# Postgres (docker-compose + all services)
POSTGRES_USER=nba
POSTGRES_PASSWORD=nba
POSTGRES_DB=nba
DATABASE_URL=postgresql+psycopg://nba:nba@localhost:5432/nba

# If another Docker stack on your machine already owns 5432/6379, override
# the *host* ports docker-compose publishes on (the container-internal ports
# stay 5432/6379 either way) — e.g. POSTGRES_HOST_PORT=5433,
# REDIS_HOST_PORT=6380 — and update DATABASE_URL/REDIS_URL below to match.
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379

# Least-privilege runtime credentials (created by the db-foundations role migrations;
# DATABASE_URL above stays the admin/migration connection).
INGESTION_DATABASE_URL=postgresql+psycopg://ingestion_writer:ingestion_writer_pw@localhost:5432/nba
API_DATABASE_URL=postgresql+psycopg://api_reader:api_reader_pw@localhost:5432/nba

# Redis (caching, week 4+)
REDIS_URL=redis://localhost:6379/0

# Ingestion sources
BALLDONTLIE_API_KEY=

# Shared secret the Next.js BFF sends to FastAPI as X-API-Key.
# Never exposed to the browser — lives only in api/.env and web/.env.local.
API_SERVICE_KEY=

# LLM provider for the NL stats search BFF route (web/app/api/search,
# web/lib/llm/*). "anthropic" | "gemini" | "groq" -- defaults to "groq"
# (free tier, LPU hardware not GPU-based) when unset. Only the selected
# provider's key below is required; the BFF throws a clear config error
# at request time rather than silently falling back to another provider
# if it's missing. Switched from "gemini" to "groq" as the default after
# live production testing showed repeated real 503 UNAVAILABLE "high
# demand" errors from a just-launched Gemini model -- Gemini remains
# fully supported as an explicit alternative.
# SEARCH_LLM_PROVIDER=groq

# Server-side only — lives only in web/.env.local, never sent to the browser.
# Required when SEARCH_LLM_PROVIDER=groq (the default).
GROQ_API_KEY=

# Server-side only — lives only in web/.env.local, never sent to the browser.
# Required only when SEARCH_LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Server-side only — lives only in web/.env.local, never sent to the browser.
# Required only when SEARCH_LLM_PROVIDER=gemini.
GEMINI_API_KEY=
